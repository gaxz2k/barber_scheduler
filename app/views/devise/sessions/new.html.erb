<% content_for :title, "Entrar | #{Current.barbershop.name}" %>

<main class="admin-login-shell">
  <section class="admin-login-card card card--elevated">
    <%= render "shared/brand" %>

    <div class="admin-kicker">Acesso restrito</div>
    <h1>Entrar no painel</h1>
    <p>Use suas credenciais administrativas para operar a barbearia.</p>

    <%= form_with url: session_path(resource_name), method: :post, scope: resource_name, class: "admin-login-form" do |form| %>
      <div class="field">
        <%= form.label :email, "E-mail" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input" %>
      </div>

      <div class="field">
        <%= form.label :password, "Senha" %>
        <%= form.password_field :password, autocomplete: "current-password", required: true, class: "input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <%= form.label :remember_me, class: "remember-label" do %>
          <%= form.check_box :remember_me %>
          <span>Lembrar de mim neste dispositivo</span>
        <% end %>
      <% end %>

      <%= form.submit "Entrar", class: "button button--primary button--full" %>
    <% end %>

    <% if devise_mapping.recoverable? %>
      <p class="login-recovery-link"><%= link_to "Esqueci minha senha", new_password_path(resource_name) %></p>
    <% end %>
  </section>
</main>
