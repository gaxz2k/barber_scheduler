<% content_for :title, "Entrar | Barbearia Senhor R" %>

<main class="admin-login-shell">
  <section class="admin-login-card">
    <%= link_to root_path, class: "brand-lockup", aria: { label: "Barbearia Senhor R, início" } do %>
      <span class="brand-mark" aria-hidden="true">Sr<span class="brand-crown">♛</span></span>
      <span>
        <span class="brand-name">Barbearia</span>
        <span class="brand-name brand-name--strong">Senhor R</span>
      </span>
    <% end %>

    <div class="eyebrow">Acesso restrito</div>
    <h1>Entrar no painel</h1>
    <p>Use suas credenciais administrativas para operar a barbearia.</p>

    <%= form_with url: session_path(resource_name), method: :post, class: "admin-login-form" do |form| %>
      <label class="login-field">
        <span>E-mail</span>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true %>
      </label>

      <label class="login-field">
        <span>Senha</span>
        <%= form.password_field :password, autocomplete: "current-password", required: true %>
      </label>

      <% if devise_mapping.rememberable? %>
        <%= form.label :remember_me, class: "remember-label" do %>
          <%= form.check_box :remember_me %>
          <span>Lembrar de mim neste dispositivo</span>
        <% end %>
      <% end %>

      <%= form.submit "Entrar", class: "button button--primary" %>
    <% end %>

    <% if devise_mapping.recoverable? %>
      <p class="login-recovery-link"><%= link_to "Esqueci minha senha", new_password_path(resource_name) %></p>
    <% end %>
  </section>
</main>
