<%= form_with model: barber do |form| %>
  <% if barber.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(barber.errors.count, "erro") %> impediram este barbeiro de ser salvo:</h2>
      <ul>
        <% barber.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nome" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit barber.new_record? ? "Criar barbeiro" : "Salvar alterações" %>
  </div>
<% end %>
