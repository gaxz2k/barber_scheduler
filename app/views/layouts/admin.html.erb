<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - Meuapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Meuapp Admin", admin_root_path, class: "navbar-brand" %>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><%= link_to "Painel", admin_root_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Barbeiros", admin_barbers_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Serviços", admin_services_path, class: "nav-link" %></li>
          </ul>
          <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
        </div>
      </div>
    </nav>

    <div class="container">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == "notice" ? "success" : "danger" %>" role="alert">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
