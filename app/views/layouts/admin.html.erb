<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Painel | #{Current.barbershop.name}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= Current.barbershop.name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0b2f3a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# A ordem importa: tokens antes de componentes antes da camada do admin,
        porque `admin_panel.css` só declara o que é específico da casca e
        confia em `var(--dt-*)` e nas classes `.button`/`.card`/`.table`
        já existirem quando o navegador aplica a cascata. %>
    <%= stylesheet_link_tag "design_tokens", "design_components", "admin_panel", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-theme="admin">
    <div class="admin-shell">
      <%# Sidebar fixa com a navegação entre as seis telas do painel — fase 4
          do redesign, no padrão do protótipo aprovado (ver admin-dashboard.html
          do protótipo). Substitui a barra superior que o admin dividia com o
          layout público por uma coluna sempre visível: o dono não perde a
          navegação ao rolar uma lista longa de agendamentos, e as seis telas
          ficam todas à vista em vez de atrás do menu hambúrguer, exceto em
          tela estreita (ver a media query no fim de `admin_panel.css`). %>
      <aside class="admin-sidebar" data-controller="nav-toggle">
        <div class="admin-sidebar__head">
          <%= link_to admin_root_path, class: "admin-brand" do %>
            <%# O lado cliente (`_booking_card_header.html.erb`) já checa se há logo
                de verdade antes de cair pro monograma de texto — aqui faltava a
                mesma checagem, então o painel sempre mostrava as iniciais ("BS")
                mesmo com uma logo real cadastrada. Replicando a mesma regra pra
                dono e cliente verem a MESMA marca, não duas diferentes. %>
            <% if Current.barbershop.logo.attached? %>
              <%= image_tag Current.barbershop.logo, class: "admin-brand__mark admin-brand__mark--image",
                            alt: "", "aria-hidden": "true" %>
            <% else %>
              <span class="admin-brand__mark" aria-hidden="true"><%= Current.barbershop.monograma %></span>
            <% end %>
            <span class="admin-brand__name"><%= Current.barbershop.name %></span>
          <% end %>

          <button type="button" class="admin-sidebar__toggle" data-action="nav-toggle#toggle" aria-expanded="false"
                  aria-controls="admin-sidebar-links" aria-label="Abrir menu do painel">
            <%= icon_tag(:menu, size: 22) %>
          </button>
        </div>

        <%# Agrupa a navegação e o rodapé num único alvo do Stimulus: em tela
            estreita os dois colapsam juntos atrás do botão acima — ver
            `.admin-sidebar-collapsible` em `admin_panel.css`. %>
        <div class="admin-sidebar-collapsible" id="admin-sidebar-links" data-nav-toggle-target="menu">
          <ul class="admin-sidebar-nav">
            <li><%= link_to admin_root_path, class: ["admin-sidebar-link", ("admin-sidebar-link--active" if current_page?(admin_root_path))] do %>
              <%= icon_tag(:grid, size: 18) %> Painel
            <% end %></li>
            <li><%= link_to admin_appointments_path, class: ["admin-sidebar-link", ("admin-sidebar-link--active" if current_page?(admin_appointments_path))] do %>
              <%= icon_tag(:calendar, size: 18) %> Agendamentos
            <% end %></li>
            <li><%= link_to admin_professionals_path, class: ["admin-sidebar-link", ("admin-sidebar-link--active" if current_page?(admin_professionals_path))] do %>
              <%= icon_tag(:user, size: 18) %> Profissionais
            <% end %></li>
            <li><%= link_to admin_services_path, class: ["admin-sidebar-link", ("admin-sidebar-link--active" if current_page?(admin_services_path))] do %>
              <%= icon_tag(:clock, size: 18) %> Serviços
            <% end %></li>
            <li><%= link_to admin_barbershop_units_path, class: ["admin-sidebar-link", ("admin-sidebar-link--active" if current_page?(admin_barbershop_units_path))] do %>
              <%= icon_tag(:pin, size: 18) %> Unidades
            <% end %></li>
            <li><%= link_to admin_barbershop_photos_path, class: ["admin-sidebar-link", ("admin-sidebar-link--active" if current_page?(admin_barbershop_photos_path))] do %>
              <%= icon_tag(:edit, size: 18) %> Fotos
            <% end %></li>
            <li><%= link_to edit_admin_shop_setting_path, class: ["admin-sidebar-link", ("admin-sidebar-link--active" if current_page?(edit_admin_shop_setting_path))] do %>
              <%= icon_tag(:lock, size: 18) %> Agendamento online
            <% end %></li>
          </ul>

          <div class="admin-sidebar__foot">
            <div class="admin-sidebar__user">
              <span class="admin-sidebar__user-avatar" aria-hidden="true"><%= current_user.email.first.upcase %></span>
              <span class="admin-sidebar__user-email"><%= current_user.email %></span>
            </div>
            <%= button_to destroy_user_session_path, method: :delete, class: "admin-sidebar__logout",
                  form: { style: "margin: 0;" } do %>
              <%= icon_tag(:x, size: 13) %> Sair
            <% end %>
          </div>
        </div>
      </aside>

      <div class="admin-main">
        <% flash.each do |type, message| %>
          <div class="admin-flash">
            <p class="alert alert--<%= type == "notice" ? "success" : "danger" %>" role="<%= type == "notice" ? "status" : "alert" %>">
              <%= icon_tag(type == "notice" ? :check : :x) %>
              <%= message %>
            </p>
          </div>
        <% end %>

        <main class="admin-content">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
