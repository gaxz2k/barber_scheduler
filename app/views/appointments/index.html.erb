<% content_for :title, "Agendar | Barbearia Senhor R" %>

<main class="site-shell customer-home booking-entry">
  <header class="customer-header">
    <%= link_to root_path, class: "brand-lockup", aria: { label: "Barbearia Senhor R, início" } do %>
      <span class="brand-mark" aria-hidden="true">Sr<span class="brand-crown">♛</span></span>
      <span>
        <span class="brand-name">Barbearia</span>
        <span class="brand-name brand-name--strong">Senhor R</span>
      </span>
    <% end %>
    <span class="header-location">Nova Odessa · SP</span>
  </header>

  <% if @barbershop_photos.any? %>
    <section class="barbershop-carousel" aria-labelledby="barbershop-carousel-title" data-controller="barbershop-carousel">
      <div class="barbershop-carousel__header">
        <div>
          <div class="eyebrow">Conheça a barbearia</div>
          <h2 id="barbershop-carousel-title">Um espaço feito para você</h2>
        </div>
        <div class="barbershop-carousel__controls">
          <button type="button" class="barbershop-carousel__button" data-barbershop-carousel-target="pause" data-action="barbershop-carousel#togglePause" aria-label="Pausar carrossel" aria-pressed="false">Ⅱ</button>
          <button type="button" class="barbershop-carousel__button" data-action="barbershop-carousel#previous" aria-label="Foto anterior">←</button>
          <button type="button" class="barbershop-carousel__button" data-action="barbershop-carousel#next" aria-label="Próxima foto">→</button>
        </div>
      </div>

      <div class="barbershop-carousel__viewport" data-barbershop-carousel-target="viewport" tabindex="0" role="region" aria-roledescription="carrossel" aria-label="Fotos da Barbearia Senhor R" data-action="keydown->barbershop-carousel#keydown mouseenter->barbershop-carousel#stop mouseleave->barbershop-carousel#start focusin->barbershop-carousel#stop focusout->barbershop-carousel#start">
        <div class="barbershop-carousel__track" data-barbershop-carousel-target="track">
          <% @barbershop_photos.each_with_index do |photo, index| %>
            <figure class="barbershop-carousel__slide" data-barbershop-carousel-target="slide" data-index="<%= index %>" aria-hidden="<%= index.zero? ? "false" : "true" %>">
              <div class="barbershop-carousel__image-wrap">
                <%= image_tag photo.image, alt: photo.caption.presence || "Foto da Barbearia Senhor R", loading: index.zero? ? "eager" : "lazy", data: { barbershop_carousel_target: "image", action: "error->barbershop-carousel#imageError" } %>
                <div class="barbershop-carousel__image-fallback" data-barbershop-carousel-target="imageFallback" hidden>
                  <span aria-hidden="true">▧</span>
                  <strong>Foto indisponível</strong>
                  <span>Tente novamente mais tarde.</span>
                </div>
              </div>
              <% if photo.caption.present? %>
                <figcaption><%= photo.caption %></figcaption>
              <% end %>
            </figure>
          <% end %>
        </div>
      </div>
      <div class="barbershop-carousel__status" aria-live="polite" aria-atomic="true" data-barbershop-carousel-target="status"></div>
    </section>
  <% else %>
    <div class="barbershop-carousel barbershop-carousel--empty" role="status">
      <div class="barbershop-carousel__empty-icon" aria-hidden="true">✦</div>
      <strong>Novas fotos em breve</strong>
      <span>Estamos preparando um tour do espaço da Barbearia Senhor R.</span>
    </div>
  <% end %>

  <div class="booking-progress" aria-label="Etapas do agendamento">
    <span class="progress-step progress-step--active"><b>1</b><span>Serviço</span></span>
    <span class="progress-line"></span>
    <span class="progress-step"><b>2</b><span>Profissional</span></span>
    <span class="progress-line"></span>
    <span class="progress-step"><b>3</b><span>Horário</span></span>
    <span class="progress-line"></span>
    <span class="progress-step"><b>4</b><span>Confirmação</span></span>
  </div>

  <section class="booking-intro" aria-labelledby="booking-title">
    <div class="eyebrow">Seu próximo cuidado começa aqui</div>
    <h1 id="booking-title">Escolha um serviço</h1>
    <p>Escolha o cuidado ideal e avançamos juntos até o seu horário.</p>
  </section>

  <% if @services.any? %>
    <ul class="service-choice-list" aria-label="Serviços disponíveis">
      <% @services.each_with_index do |service, index| %>
        <li>
          <%= link_to new_appointment_path(service: service.id), class: "service-choice-card", data: { turbo: false } do %>
          <span class="service-choice-card__number" aria-hidden="true"><%= format("%02d", index + 1) %></span>
          <span class="service-choice-card__body">
            <strong><%= service.name %></strong>
            <span><%= service.duration_minutes %> min</span>
          </span>
          <span class="service-choice-card__arrow" aria-hidden="true">→</span>
            <% end %>
          </li>
        <% end %>
      </ul>
  <% else %>
    <div class="customer-empty-state" role="status">
      <strong>Ainda não há serviços cadastrados.</strong>
      <span>Assim que os serviços forem cadastrados, eles aparecerão aqui.</span>
    </div>
  <% end %>

  <footer class="customer-footer">
    <span>Barbearia Senhor R</span>
    <span>·</span>
    <span>Nova Odessa, SP</span>
  </footer>
</main>
