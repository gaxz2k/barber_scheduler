<%# Cabeçalho do card único de agendamento, na composição aprovada no
    mockup "Aço & Couro" (ver `tmp/design-proposal/mockup-1/index.html` e
    `palettes.md`): banner de cor chapada (carvão) atrás do card,
    logo/monograma centralizado, nome, telefone e endereço em linhas
    separadas, dois botões quadrados de ação rápida (WhatsApp e ligar) e,
    meio dentro/meio fora da borda do card, o botão estático de "Consultar
    Agendamento" (ver lacuna 5 do contexto: sem link funcional, a busca de
    agendamento por telefone não existe no backend hoje).

    Vive em partial porque as três telas que abrem e fecham o fluxo —
    a home (`index.html.erb`), a etapa 1 do card único (`new.html.erb`) e o
    recibo (`show.html.erb`) — precisam do mesmo cabeçalho.

    O nome da barbearia usa Fraunces (display) na paleta aprovada —
    carregado só aqui (e não no layout inteiro) via `content_for :head`,
    para não pagar o custo de uma fonte externa em telas que não usam este
    cabeçalho (admin, login). Public Sans (corpo) é carregado no mesmo
    `<link>` porque o resto da tela de agendamento (labels, botões, selects,
    texto corrido) também usa essa família — ver `--ref-font-body` em
    `booking_wizard.css`. Se o Google Fonts não carregar (rede bloqueada,
    CSP), os `font-family` caem para a pilha padrão do projeto — ver
    `--ref-name-font`/`--ref-font-body` em `booking_wizard.css`. %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>
<div class="booking-card-header-shell">
  <div class="booking-card-header-banner" aria-hidden="true"></div>

  <header class="booking-card-header">
    <% if Current.barbershop.logo.attached? %>
      <%= image_tag Current.barbershop.logo, class: "booking-card-header__logo-image",
                     alt: "Logo de #{Current.barbershop.name}" %>
    <% else %>
      <span class="booking-card-header__logo" aria-hidden="true"><%= Current.barbershop.monograma %></span>
    <% end %>

    <h1 class="booking-card-header__name"><%= Current.barbershop.name %></h1>

    <% if Current.barbershop.phone.present? || Current.barbershop.address.present? %>
      <p class="booking-card-header__meta">
        <% if Current.barbershop.phone.present? %>
          <span><%= Current.barbershop.phone %></span>
        <% end %>
        <% if Current.barbershop.address.present? %>
          <span><%= Current.barbershop.address %></span>
        <% end %>
      </p>
    <% end %>

    <% if Current.barbershop.whatsapp_link.present? || Current.barbershop.phone.present? %>
      <div class="booking-card-header__actions">
        <% if Current.barbershop.whatsapp_link.present? %>
          <%= link_to Current.barbershop.whatsapp_link, class: "booking-card-header__action booking-card-header__action--whatsapp", rel: "noopener",
                      aria: { label: "Falar no WhatsApp com #{Current.barbershop.name}" } do %>
            <%= icon_tag(:whatsapp, size: 22) %>
          <% end %>
        <% end %>
        <% if Current.barbershop.phone.present? %>
          <%= link_to "tel:#{Current.barbershop.phone.gsub(/\D/, '')}", class: "booking-card-header__action booking-card-header__action--phone",
                      aria: { label: "Ligar para #{Current.barbershop.name}" } do %>
            <%= icon_tag(:phone, size: 22) %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </header>

  <%# "Consultar Agendamento" agora é um link funcional (ver
      `Appointments::PhoneLookup` e `appointments#lookup`): a busca por
      telefone existe no backend desde o cadastro de e-mail/CPF/consulta. %>
  <%= link_to "Consultar Agendamento", appointments_lookup_path, class: "booking-card-header__consult" %>
</div>
