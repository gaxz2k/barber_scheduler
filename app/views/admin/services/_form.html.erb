<%= form_with model: [:admin, service], class: "admin-form" do |form| %>
  <% if service.errors.any? %>
    <div class="admin-alert admin-alert--error" id="error_explanation" role="alert">
      <strong><%= pluralize(service.errors.count, "erro") %> impediram este serviço de ser salvo:</strong>
      <ul>
        <% service.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form__group">
    <%= form.label :name, "Nome do serviço" %>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <div class="admin-form__group">
    <%= form.label :duration_minutes, "Duração em minutos" %>
    <%= form.number_field :duration_minutes, required: true, min: 1, step: 1 %>
  </div>

  <div class="admin-form__actions">
    <%= form.submit service.new_record? ? "Criar serviço" : "Salvar alterações", class: "admin-button" %>
    <%= link_to "Cancelar", admin_services_path, class: "admin-button admin-button--quiet" %>
  </div>
<% end %>
