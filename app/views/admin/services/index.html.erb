<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="m-0">Serviços</h1>
  <%= link_to "Novo serviço", new_admin_service_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped align-middle">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Duração</th>
      <th class="text-end">Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @services.each do |service| %>
      <tr>
        <td><%= service.name %></td>
        <td><%= service.duration_minutes %> min</td>
        <td class="text-end">
          <%= link_to "Editar", edit_admin_service_path(service), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Excluir", admin_service_path(service), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Tem certeza?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
