<% content_for :title, "Agendamento | Admin" %>

<section class="admin-detail-card card">
  <div class="admin-kicker">Detalhes do atendimento</div>
  <h1><%= @appointment.client.name %></h1>

  <div class="admin-detail-row"><span>Profissional</span><span><%= @appointment.professional.name %></span></div>
  <div class="admin-detail-row"><span>Serviço</span><span><%= @appointment.service.name %></span></div>
  <div class="admin-detail-row"><span>Início</span><span><%= l(@appointment.start_at, format: :long) %></span></div>
  <div class="admin-detail-row"><span>Fim</span><span><%= l(@appointment.end_at, format: :long) %></span></div>
  <div class="admin-detail-row"><span>Status</span><span><span class="<%= status_badge_class(@appointment.status) %>"><%= @appointment.status_label %></span></span></div>

  <% if @appointment.customer_note.present? %>
    <div class="admin-detail-row"><span>Mensagem do cliente</span><span><%= @appointment.customer_note %></span></div>
  <% end %>

  <div class="admin-form__actions">
    <%= link_to "Editar", edit_admin_appointment_path(@appointment), class: "button button--primary" %>
    <%= link_to "Voltar", admin_appointments_path, class: "button button--ghost" %>
  </div>
</section>
