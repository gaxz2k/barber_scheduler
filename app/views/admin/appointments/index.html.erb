<% content_for :title, "Agendamentos | Admin" %>

<section class="admin-page-header">
  <div>
    <div class="admin-kicker">Operação diária</div>
    <h1 class="admin-page-title">Agendamentos</h1>
    <p class="admin-page-description">Consulte os horários reservados, ajuste a agenda e mantenha cada atendimento bem organizado.</p>
  </div>
  <%= link_to "Novo agendamento", new_admin_appointment_path, class: "button button--primary" %>
</section>

<%# Busca por cliente + chips de status — os dois filtram de verdade via
    querystring (ver `Admin::AppointmentsController#index`), nenhum é
    decoração client-side sobre uma lista já carregada inteira. %>
<div class="card admin-filters-card">
  <%= form_with url: admin_appointments_path, method: :get, class: "admin-filters-card__search" do |form| %>
    <%= hidden_field_tag :status, @status_filter if @status_filter %>
    <div class="field" style="margin-bottom: 0;">
      <%= form.label :q, "Buscar por cliente", class: "field__label" %>
      <%= form.text_field :q, value: @search, placeholder: "Nome do cliente…", class: "input" %>
    </div>
  <% end %>

  <div class="admin-chip-row">
    <%= link_to admin_appointments_path(q: @search.presence), class: ["admin-chip", ("admin-chip--active" if @status_filter.nil?)] do %>
      Todos <span class="admin-chip__count"><%= @status_counts.values.sum %></span>
    <% end %>
    <% Admin::AppointmentsController::STATUS_FILTERS.each do |status| %>
      <%= link_to admin_appointments_path(status: status, q: @search.presence), class: ["admin-chip", ("admin-chip--active" if @status_filter == status)] do %>
        <%= Appointment.new(status: status).status_label %> <span class="admin-chip__count"><%= @status_counts[status].to_i %></span>
      <% end %>
    <% end %>
  </div>
</div>

<% if @appointments.empty? %>
  <div class="empty-state card">
    <%= empty_state_illustration(:no_appointments) %>
    <% if @status_filter || @search.present? %>
      <p class="empty-state__title">Nenhum agendamento encontrado</p>
      <p class="empty-state__text">Nenhum resultado para os filtros aplicados. Tente limpar a busca ou o status.</p>
      <%= link_to "Limpar filtros", admin_appointments_path, class: "button button--secondary" %>
    <% else %>
      <p class="empty-state__title">Nenhum agendamento cadastrado</p>
      <p class="empty-state__text">Quando você ou um cliente marcar um horário, ele aparece aqui.</p>
      <%= link_to "Novo agendamento", new_admin_appointment_path, class: "button button--primary" %>
    <% end %>
  </div>
<% else %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Cliente</th>
          <th>Profissional</th>
          <th>Serviço</th>
          <th>Início</th>
          <th>Status</th>
          <th><span class="visually-hidden">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% @appointments.each do |appointment| %>
          <tr>
            <td><strong><%= appointment.client.name %></strong></td>
            <td><%= appointment.professional.name %></td>
            <td><%= appointment.service.name %></td>
            <td><%= l(appointment.start_at, format: :short) %></td>
            <td><span class="<%= status_badge_class(appointment.status) %>"><%= appointment.status_label %></span></td>
            <td>
              <div class="table__actions">
                <%= link_to edit_admin_appointment_path(appointment), class: "button button--secondary button--sm", aria: { label: "Editar agendamento de #{appointment.client.name}" } do %>
                  <%= icon_tag(:edit, size: 16) %> <span class="visually-hidden">Editar</span>
                <% end %>
                <%= button_to admin_appointment_path(appointment), method: :delete,
                      class: "button button--danger button--sm",
                      form: { data: { turbo_confirm: "Excluir este agendamento?" } },
                      aria: { label: "Excluir agendamento de #{appointment.client.name}" } do %>
                  <%= icon_tag(:trash, size: 16) %> <span class="visually-hidden">Excluir</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
