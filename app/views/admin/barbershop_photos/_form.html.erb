<%= form_with model: [:admin, photo] do |form| %>
  <% if photo.errors.any? %>
    <div class="alert alert--danger" id="error_explanation" role="alert">
      <%= icon_tag(:x) %>
      <div>
        <strong><%= pluralize(photo.errors.count, "erro") %> impediram esta foto de ser salva:</strong>
        <ul>
          <% photo.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :image, photo.new_record? ? "Foto" : "Trocar foto", class: "field__label" %>
    <%= form.file_field :image, accept: "image/png,image/jpeg,image/webp", required: photo.new_record?, class: "input" %>
    <span class="field__hint">PNG, JPG ou WEBP, até 10 MB.</span>
  </div>

  <div class="field">
    <%= form.label :caption, "Legenda", class: "field__label" %>
    <%= form.text_field :caption, maxlength: 140, placeholder: "Ex.: Corte clássico com acabamento", class: "input" %>
    <span class="field__hint">A legenda aparece sobre a foto no carrossel.</span>
  </div>

  <div class="field">
    <%= form.label :position, "Ordem", class: "field__label" %>
    <%= form.number_field :position, min: 0, step: 1, required: true, class: "input" %>
    <span class="field__hint">Menor número aparece primeiro.</span>
  </div>

  <label class="toggle-card">
    <%= form.check_box :active %>
    <span>
      <strong>Publicar no carrossel</strong>
      <small>Desmarque para ocultar sem excluir a imagem.</small>
    </span>
  </label>

  <% if photo.persisted? && photo.image.attached? && photo.image.blob&.persisted? %>
    <div class="admin-current-image">
      <span>Imagem atual</span>
      <%= image_tag photo.image, alt: photo.caption.presence || "Foto da #{Current.barbershop.name}" %>
    </div>
  <% end %>

  <div class="admin-form__actions">
    <%= form.submit photo.new_record? ? "Adicionar foto" : "Salvar alterações", class: "button button--primary" %>
    <%= link_to "Cancelar", admin_barbershop_photos_path, class: "button button--ghost" %>
  </div>
<% end %>
