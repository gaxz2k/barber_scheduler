<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="m-0">Barbeiros</h1>
  <%= link_to "Novo barbeiro", new_admin_barber_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped align-middle">
  <thead>
    <tr>
      <th>Nome</th>
      <th class="text-end">Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @barbers.each do |barber| %>
      <tr>
        <td><%= barber.name %></td>
        <td class="text-end">
          <%= link_to "Editar", edit_admin_barber_path(barber), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Excluir", admin_barber_path(barber), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Tem certeza?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
