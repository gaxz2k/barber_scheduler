<% content_for :title, "Profissionais | Admin" %>

<section class="admin-header-row">
  <div>
    <div class="admin-kicker">Equipe</div>
    <h1 class="admin-page-title">Profissionais</h1>
    <p class="admin-page-description">Mantenha o time da barbearia e os profissionais disponíveis para atendimento.</p>
  </div>
  <%= link_to "Novo profissional", new_admin_professional_path, class: "admin-button" %>
</section>

<div class="admin-table-wrap">
  <% if @professionals.empty? %>
    <div class="admin-empty">Nenhum profissional cadastrado.</div>
  <% else %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Profissional</th>
          <th><span class="visually-hidden">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% @professionals.each do |professional| %>
          <tr>
            <td><strong><%= professional.name %></strong></td>
            <td>
              <div class="admin-table__actions">
                <%= link_to "Editar", edit_admin_professional_path(professional), class: "admin-button admin-button--quiet" %>
                <%= button_to "Excluir", admin_professional_path(professional), method: :delete, class: "admin-button admin-button--danger", form: { data: { turbo_confirm: "Excluir este profissional?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
