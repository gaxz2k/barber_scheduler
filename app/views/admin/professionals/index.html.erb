<% content_for :title, "Profissionais | Admin" %>

<section class="admin-page-header">
  <div>
    <div class="admin-kicker">Equipe</div>
    <h1 class="admin-page-title">Profissionais</h1>
    <p class="admin-page-description">Mantenha o time da barbearia e os profissionais disponíveis para atendimento.</p>
  </div>
  <%= link_to "Novo profissional", new_admin_professional_path, class: "button button--primary" %>
</section>

<% if @professionals.empty? %>
  <div class="empty-state card">
    <%= empty_state_illustration(:no_professionals) %>
    <p class="empty-state__title">Nenhum profissional cadastrado</p>
    <p class="empty-state__text">Cadastre o primeiro profissional para liberar os agendamentos.</p>
    <%= link_to "Novo profissional", new_admin_professional_path, class: "button button--primary" %>
  </div>
<% else %>
  <%# O aviso só faz sentido quando existe mais de uma unidade: com uma só,
      "padrão da unidade" é sempre o mesmo profissional-base que a agenda já
      usaria sem nenhuma configuração — avisar aqui seria descrever uma
      escolha que não existe. %>
  <% if Current.barbershop.unidades.count > 1 %>
    <div class="admin-pro-hint">
      <%= icon_tag(:check, size: 16) %>
      <div><strong>Profissional padrão no agendamento online.</strong> Quem estiver marcado como "Padrão" aparece pré-selecionado quando o cliente escolhe um serviço, para cada unidade — o cliente pode trocar a qualquer momento. Use "Definir como padrão" no cartão do profissional.</div>
    </div>
  <% end %>

  <div class="admin-pro-grid">
    <% @professionals.each do |professional| %>
      <div class="card admin-pro-card">
        <div class="admin-pro-card__photo">
          <% if professional.photo? %>
            <%= image_tag professional.photo_blob, alt: professional.name, loading: "lazy" %>
          <% else %>
            <span class="admin-table__avatar admin-table__avatar--placeholder" aria-hidden="true"><%= professional.name.first %></span>
          <% end %>
        </div>
        <div class="admin-pro-card__body">
          <h3><%= professional.name %></h3>
          <% if professional.specialty_label %>
            <div class="admin-pro-card__specialty"><%= professional.specialty_label %></div>
          <% end %>
          <% if professional.barbershop_unit.present? %>
            <span class="admin-pro-card__unit">
              <%= icon_tag(:pin, size: 11) %> <%= professional.barbershop_unit.name %>
            </span>
          <% end %>

          <div class="admin-pro-card__actions">
            <%= link_to edit_admin_professional_path(professional), class: "button button--secondary button--sm", aria: { label: "Editar #{professional.name}" } do %>
              <%= icon_tag(:edit, size: 16) %> Editar
            <% end %>
            <%= link_to admin_professional_path(professional), class: "button button--secondary button--sm", aria: { label: "Ver #{professional.name}" } do %>
              Detalhes
            <% end %>
            <%= button_to admin_professional_path(professional), method: :delete,
                  class: "button button--danger button--sm",
                  form: { data: { turbo_confirm: "Excluir este profissional?" } },
                  aria: { label: "Excluir #{professional.name}" } do %>
              <%= icon_tag(:trash, size: 16) %>
            <% end %>
          </div>

          <%# O selo e o botão só existem quando o profissional tem unidade —
              ver o comentário de `Admin::ProfessionalsController#set_default`
              sobre por que "padrão" não faz sentido sem uma unidade dona. %>
          <% if professional.barbershop_unit.present? %>
            <div class="admin-pro-card__default-row">
              <% if professional.barbershop_unit.default_professional_id == professional.id %>
                <span class="admin-pro-card__default-badge" title="Padrão da unidade <%= professional.barbershop_unit.name %>">
                  <%= icon_tag(:check, size: 13) %> Profissional padrão
                </span>
              <% else %>
                <span class="tiny" style="color: var(--dt-ink-soft); font-size: var(--dt-text-xs);">Não é o padrão</span>
                <%= button_to set_default_admin_professional_path(professional), method: :patch,
                      class: "admin-set-default-btn",
                      form: { data: { turbo_confirm: "Definir #{professional.name} como padrão da unidade #{professional.barbershop_unit.name}?" } },
                      aria: { label: "Definir #{professional.name} como padrão" } do %>
                  Definir como padrão
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
