<%= form_with model: [:admin, professional], class: "admin-form" do |form| %>
  <% if professional.errors.any? %>
    <div class="admin-alert admin-alert--error" id="error_explanation" role="alert">
      <strong><%= pluralize(professional.errors.count, "erro") %> impediram este profissional de ser salvo:</strong>
      <ul>
        <% professional.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form__group">
    <%= form.label :name, "Nome do profissional" %>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <div class="admin-form__actions">
    <%= form.submit professional.new_record? ? "Criar profissional" : "Salvar alterações", class: "admin-button" %>
    <%= link_to "Cancelar", admin_professionals_path, class: "admin-button admin-button--quiet" %>
  </div>
<% end %>
