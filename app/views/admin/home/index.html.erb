<% content_for :title, "Admin | Barbearia Senhor R" %>

<section class="admin-header-row">
  <div>
    <div class="admin-kicker">Painel operacional</div>
    <h1 class="admin-page-title">Tudo sob controle</h1>
    <p class="admin-page-description">Acompanhe a agenda, organize a equipe e mantenha a presença digital da barbearia em dia.</p>
  </div>
</section>

<% if @missing_setup.any? %>
  <section class="admin-dashboard-hero">
    <div class="admin-dashboard-hero__copy">
      <p><strong>Ainda falta configurar a barbearia antes de atender.</strong></p>
      <p>Sem estes itens o cliente não consegue concluir um agendamento. Cada um abaixo leva direto à tela correspondente.</p>
      <ul class="setup-checklist">
        <% @missing_setup.each do |item| %>
          <li>
            <%= link_to setup_label(item), setup_path(item), class: "setup-checklist__link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% else %>
  <section class="admin-dashboard-hero">
    <div class="admin-dashboard-hero__copy">
      <p><strong>Seu painel está pronto para atender.</strong></p>
      <p>Serviços, profissionais, unidades e horários cadastrados. Use os atalhos abaixo para cuidar da agenda e da presença digital.</p>
    </div>
  </section>
<% end %>

<section class="professional-grid" aria-label="Atalhos administrativos">
  <%= link_to admin_appointments_path, class: "professional-card" do %>
    <span class="professional-avatar" aria-hidden="true">⌁</span>
    <span class="professional-card__content">
      <span class="professional-card__name">Agendamentos</span>
      <span class="professional-card__caption">Consulte e organize os horários reservados.</span>
      <span class="professional-card__action">Abrir agenda →</span>
    </span>
  <% end %>

  <%= link_to admin_professionals_path, class: "professional-card" do %>
    <span class="professional-avatar" aria-hidden="true">✦</span>
    <span class="professional-card__content">
      <span class="professional-card__name">Profissionais</span>
      <span class="professional-card__caption">Gerencie quem atende na barbearia.</span>
      <span class="professional-card__action">Gerenciar equipe →</span>
    </span>
  <% end %>

  <%= link_to admin_services_path, class: "professional-card" do %>
    <span class="professional-avatar" aria-hidden="true">▦</span>
    <span class="professional-card__content">
      <span class="professional-card__name">Serviços</span>
      <span class="professional-card__caption">Atualize o cardápio e as durações.</span>
      <span class="professional-card__action">Ver serviços →</span>
    </span>
  <% end %>

  <%= link_to admin_barbershop_units_path, class: "professional-card" do %>
    <span class="professional-avatar" aria-hidden="true">⌂</span>
    <span class="professional-card__content">
      <span class="professional-card__name">Unidades</span>
      <span class="professional-card__caption">Lojas e o horário de funcionamento de cada uma.</span>
      <span class="professional-card__action">Gerenciar unidades →</span>
    </span>
  <% end %>

  <%= link_to admin_barbershop_photos_path, class: "professional-card" do %>
    <span class="professional-avatar" aria-hidden="true">▧</span>
    <span class="professional-card__content">
      <span class="professional-card__name">Fotos da barbearia</span>
      <span class="professional-card__caption">Monte o carrossel da tela inicial.</span>
      <span class="professional-card__action">Editar galeria →</span>
    </span>
  <% end %>
</section>
